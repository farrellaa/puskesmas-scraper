POSTGRES_PASSWORD=replace-with-a-long-random-secret
WEB_PORT=3003
ALLOW_PRIVATE_DESTINATIONS=false
COOKIE_SECURE=true
DUMMY_ENDPOINT=http://dummy:8110/ingest
SCRAPER_DOMAIN=scraper.your-organization.example

# Server capacity; patient/tab defaults are configured by Admin in the app.
SYSTEM_MAX_CONCURRENT_JOBS=1
APP_MEMORY_LIMIT=2g
